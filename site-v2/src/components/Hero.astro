---
import { Image } from "astro:assets";
import type { HomeContent } from "../content/home";
import Button from "./Button.astro";
import heroPhoto from "../assets/hero.png";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;

const [before, after] = content.hero.h1.split(content.hero.h1Accent);
const accentClass =
  content.lang === "en" ? "italic font-normal text-accent" : "text-accent";
---

<section class="relative isolate flex min-h-[90vh] items-end overflow-hidden">
  <Image
    src={heroPhoto}
    alt=""
    class:list={[
      "absolute inset-0 -z-10 h-full w-full object-cover",
      content.dir === "ltr" && "scale-x-[-1]",
    ]}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/20"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4 pb-16 pt-32 sm:px-6 sm:pb-24">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-text-dim">
      {content.hero.eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl font-heading text-4xl font-bold leading-[1.1] text-text sm:text-6xl">
      {before}<span class={accentClass}>{content.hero.h1Accent}</span>{after}
    </h1>
    <p class="mt-6 max-w-xl text-base text-text-dim sm:text-lg">
      {content.hero.sub}
    </p>
    <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
      <Button href="#contact" variant="primary">{content.hero.ctaPrimary}</Button>
      <Button href={content.whatsappHref} variant="secondary">{content.hero.ctaSecondary}</Button>
    </div>
  </div>
</section>

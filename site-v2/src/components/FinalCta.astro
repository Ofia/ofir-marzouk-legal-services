---
import { Image } from "astro:assets";
import type { HomeContent } from "../content/home";
import Button from "./Button.astro";
import courthousePhoto from "../assets/courthouse.jpg";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;
const privacyHref = content.lang === "he" ? "/privacy" : "/en/privacy";
const nameLabel = content.lang === "he" ? "שם מלא" : "Full name";
const emailLabel = content.lang === "he" ? "אימייל" : "Email";
const phoneLabel = content.lang === "he" ? "טלפון" : "Phone";
const messageLabel = content.lang === "he" ? "הודעה" : "Message";
const submitLabel = content.lang === "he" ? "שליחה" : "Send";
const consentLabel =
  content.lang === "he"
    ? `קראתי ואני מאשר/ת את מדיניות הפרטיות`
    : `I've read and agree to the privacy policy`;
---

<section id="contact" class="relative isolate overflow-hidden bg-ink scroll-mt-24">
  <Image
    src={courthousePhoto}
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45 grayscale"
    widths={[640, 1024, 1600]}
    sizes="100vw"
  />
  <div class="absolute inset-0 -z-10 bg-ink/55"></div>

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2" data-reveal>
    <div class="text-center lg:text-start">
      <h2 class="font-heading text-2xl font-bold text-text sm:text-4xl">{content.finalCta.title}</h2>
      <p class="mt-4 text-sm text-text-dim sm:text-base">{content.finalCta.blurb}</p>
      <div class="mt-6 flex justify-center sm:justify-start">
        <Button href={content.phoneHref} variant="secondary">{content.finalCta.ctaPrimary}</Button>
      </div>
    </div>

    <!-- Submits to Formspree directly; honeypot/rate-limit/custom success state is Phase 2 scope. -->
    <form class="rounded-lg bg-ink-soft p-6" action="https://formspree.io/f/xzedpwvo" method="POST">
      <div class="grid gap-4">
        <label class="text-sm font-semibold text-text">
          {nameLabel}
          <input type="text" name="name" required class="mt-1 w-full rounded-md border border-ink-line bg-transparent px-3 py-2 text-sm text-text" />
        </label>
        <label class="text-sm font-semibold text-text">
          {emailLabel}
          <input type="email" name="email" required class="mt-1 w-full rounded-md border border-ink-line bg-transparent px-3 py-2 text-sm text-text" />
        </label>
        <label class="text-sm font-semibold text-text">
          {phoneLabel}
          <input type="tel" name="phone" class="mt-1 w-full rounded-md border border-ink-line bg-transparent px-3 py-2 text-sm text-text" />
        </label>
        <label class="text-sm font-semibold text-text">
          {messageLabel}
          <textarea name="message" required rows="3" class="mt-1 w-full rounded-md border border-ink-line bg-transparent px-3 py-2 text-sm text-text"></textarea>
        </label>
        <label class="flex items-start gap-2 text-xs text-text-dim">
          <input type="checkbox" required class="mt-0.5" />
          <span>
            {consentLabel} (<a href={privacyHref} class="underline">{content.footer.legal[0]}</a>)
          </span>
        </label>
        <button type="submit" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink hover:bg-accent-deep">
          {submitLabel}
        </button>
      </div>
    </form>
  </div>
</section>

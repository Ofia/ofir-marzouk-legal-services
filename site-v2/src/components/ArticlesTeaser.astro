---
import { Image } from "astro:assets";
import type { HomeContent } from "../content/home";
import { articlesHe, articlesEn } from "../content/articles";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;

const articles = content.lang === "he" ? articlesHe : articlesEn;
const base = content.lang === "he" ? "/articles" : "/en/articles";
---

<section class="bg-ink">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24" data-reveal>
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-text-dim">
      {content.lang === "he" ? "תוכן" : "Articles"}
    </p>
    <h2 class="mt-3 font-heading text-2xl font-bold text-text sm:text-4xl">
      {content.articles.title}
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {articles.map((article) => (
        <a href={`${base}/${article.slug}`} class="group block">
          <div class="aspect-[4/3] overflow-hidden rounded-lg">
            <Image
              src={article.photo}
              alt=""
              width={500}
              height={375}
              class="h-full w-full object-cover grayscale transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <span class="mt-3 block text-xs font-semibold text-accent">{article.dateDisplay}</span>
          <h3 class="mt-1 font-heading text-base font-semibold text-text">{article.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

---
import type { HomeContent } from "../content/home";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;

const slugs = ["interpol-red-notice", "extradition", "foreign-indictment", "cybercrime-online-trading"];
const base = content.lang === "he" ? "/practice-areas" : "/en/practice-areas";
---

<section class="bg-ink">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24" data-reveal>
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-text-dim">
      {content.lang === "he" ? "מצבי חירום" : "Urgent Situations"}
    </p>
    <h2 class="mt-3 max-w-2xl font-heading text-2xl font-bold text-text sm:text-4xl">
      {content.urgent.title}
    </h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-lg bg-ink-line sm:grid-cols-2 lg:grid-cols-4">
      {content.urgent.items.map((item, i) => (
        <a href={`${base}/${slugs[i]}`} class="group flex flex-col bg-ink-soft p-6 transition-colors hover:bg-ink">
          <h3 class="font-heading text-lg font-semibold text-text">{item.title}</h3>
          <p class="mt-2 flex-1 text-sm text-text-dim">{item.blurb}</p>
          <span class="mt-4 text-xs font-semibold text-accent opacity-0 transition-opacity group-hover:opacity-100">
            {content.lang === "he" ? `עוד על ${item.title} ←` : `More on ${item.title} →`}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

---
import type { HomeContent } from "../content/home";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;
---

<!-- New copy, drafted neutrally from the existing service descriptions — no stats or outcome claims. Flag: REVIEW -->
<section class="bg-ink-soft">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24" data-reveal>
    <h2 class="text-center font-heading text-2xl font-bold text-text sm:text-4xl">
      {content.faq.title}
    </h2>
    <div class="mt-8 divide-y divide-ink-line border-y border-ink-line">
      {content.faq.items.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between font-heading text-base font-semibold text-text">
            {item.q}
            <span class="ms-4 shrink-0 text-accent transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm text-text-dim sm:text-base">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

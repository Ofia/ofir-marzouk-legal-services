---
import type { HomeContent } from "../content/home";

interface Props {
  content: HomeContent;
}
const { content } = Astro.props;

const slugs = [
  "cybercrime-online-trading",
  "extradition",
  "interpol-red-notice",
  "international-arrest",
  "foreign-indictment",
  "plea-agreements",
];
const base = content.lang === "he" ? "/practice-areas" : "/en/practice-areas";
---

<section class="bg-ink">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24" data-reveal>
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-text-dim">
      {content.lang === "he" ? "תחומי התמחות" : "Practice Areas"}
    </p>
    <h2 class="mt-3 font-heading text-2xl font-bold text-text sm:text-4xl">
      {content.practiceAreas.title}
    </h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-lg bg-ink-line sm:grid-cols-2 lg:grid-cols-3">
      {content.practiceAreas.items.map((item, i) => (
        <a href={`${base}/${slugs[i]}`} class="group bg-ink-soft p-6 transition-colors hover:bg-ink">
          <h3 class="font-heading text-lg font-semibold text-text">{item.title}</h3>
          <p class="mt-2 text-sm text-text-dim">{item.blurb}</p>
          <span class="mt-4 inline-block text-xs font-semibold text-accent opacity-0 transition-opacity group-hover:opacity-100">
            {content.lang === "he" ? `עוד על ${item.title} ←` : `More on ${item.title} →`}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

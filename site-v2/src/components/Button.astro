---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "primary", class: extraClass = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-body text-sm font-semibold transition-colors sm:text-base";

const variants: Record<string, string> = {
  primary: "bg-accent text-ink hover:bg-accent-deep",
  secondary: "border border-ink-line text-text hover:border-accent hover:text-accent",
  ghost: "text-text underline underline-offset-4 hover:text-accent",
};
---

<a href={href} class={`${base} ${variants[variant]} ${extraClass}`}>
  <slot />
</a>

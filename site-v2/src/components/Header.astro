---
import type { HomeContent } from "../content/home";

interface Props {
  content: HomeContent;
}

const { content } = Astro.props;

// Equivalent path in the other language for the current page, not just the homepage.
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isEnPath = rawPath === "/en" || rawPath.startsWith("/en/");
const basePath = isEnPath ? rawPath.replace(/^\/en/, "") || "/" : rawPath;
const otherLangHref = content.lang === "he" ? (basePath === "/" ? "/en" : `/en${basePath}`) : basePath;

const navItems = [
  { label: content.nav.home, href: content.lang === "he" ? "/" : "/en" },
  { label: content.nav.about, href: content.lang === "he" ? "/about" : "/en/about" },
  { label: content.nav.practiceAreas, href: content.lang === "he" ? "/practice-areas" : "/en/practice-areas" },
  { label: content.nav.articles, href: content.lang === "he" ? "/articles" : "/en/articles" },
  { label: content.nav.contact, href: content.lang === "he" ? "/contact" : "/en/contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-gradient-to-b from-ink/80 via-ink/40 to-transparent">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
    <a href={content.lang === "he" ? "/" : "/en"} class="shrink-0">
      <img src="/images/logo.png" alt="עו״ד אופיר מרזוק" class="h-10 w-auto" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="font-body text-sm font-semibold text-text/90 hover:text-accent">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={otherLangHref} class="rounded-full border border-ink-line px-3 py-1 text-xs font-semibold text-text/90 hover:border-accent hover:text-accent">
        {content.otherLangLabel}
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="list-none rounded-md border border-ink-line px-3 py-2 text-text" aria-label="Menu">☰</summary>
      <div class="absolute end-0 top-full mt-2 w-56 rounded-lg border border-ink-line bg-ink-soft p-4 shadow-lg">
        <nav class="flex flex-col gap-3">
          {navItems.map((item) => (
            <a href={item.href} class="font-body text-sm font-semibold text-text/90 hover:text-accent">
              {item.label}
            </a>
          ))}
          <a href={otherLangHref} class="font-body text-sm font-semibold text-text/90 hover:text-accent">
            {content.otherLangLabel}
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>

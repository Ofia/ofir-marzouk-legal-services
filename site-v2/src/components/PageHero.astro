---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  photo: ImageMetadata;
  eyebrow?: string;
  title: string;
  flip?: boolean;
}
const { photo, eyebrow, title, flip = false } = Astro.props;
---

<section class="relative isolate flex min-h-[46vh] items-end overflow-hidden pt-20">
  <Image
    src={photo}
    alt=""
    class:list={["absolute inset-0 -z-10 h-full w-full object-cover grayscale", flip && "scale-x-[-1]"]}
    widths={[640, 1024, 1600]}
    sizes="100vw"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/75 to-ink/40"></div>

  <div class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6">
    {eyebrow && (
      <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-text-dim">{eyebrow}</p>
    )}
    <h1 class="mt-3 max-w-2xl font-heading text-3xl font-bold leading-tight text-text sm:text-5xl">
      {title}
    </h1>
  </div>
</section>

---
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { articlesHe } from "../../content/articles";
import { he } from "../../content/home";
import heroPhoto from "../../assets/hero.png";
---

<PageLayout
  title='מאמרים | עו"ד אופיר מרזוק'
  description="מאמרים בנושאי הסגרה, הודעות אדומות של אינטרפול, מעצרים בינלאומיים ומסחר אונליין."
  content={he}
>
  <PageHero photo={heroPhoto} eyebrow="תוכן" title="מאמרים אחרונים" />
  <section class="bg-ink">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="grid gap-8 sm:grid-cols-3">
        {articlesHe.map((article) => (
          <a href={`/articles/${article.slug}`} class="group block">
            <div class="aspect-[4/3] overflow-hidden rounded-lg">
              <Image
                src={article.photo}
                alt=""
                width={500}
                height={375}
                class="h-full w-full object-cover grayscale transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <span class="mt-3 block text-xs font-semibold text-accent">{article.dateDisplay}</span>
            <h2 class="mt-1 font-heading text-lg font-semibold text-text">{article.title}</h2>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

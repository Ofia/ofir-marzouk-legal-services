---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/Button.astro";
import { articlesHe } from "../../content/articles";
import { he } from "../../content/home";

export function getStaticPaths() {
  return articlesHe.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const otherArticles = articlesHe.filter((a) => a.slug !== article.slug);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    datePublished: article.date,
    dateModified: article.date,
    inLanguage: "he",
    author: { "@type": "Person", name: "Ofir Marzouk" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "דף הבית", item: "https://ofirmarzouk.com/" },
      { "@type": "ListItem", position: 2, name: "מאמרים", item: "https://ofirmarzouk.com/articles" },
      { "@type": "ListItem", position: 3, name: article.title, item: `https://ofirmarzouk.com/articles/${article.slug}` },
    ],
  },
];
---

<PageLayout title={`${article.title} | עו"ד אופיר מרזוק`} description={article.title} content={he} schema={schema}>
  <PageHero photo={article.photo} eyebrow={article.dateDisplay} title={article.title} />

  <section>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <a href="/articles" class="text-sm font-semibold text-accent">← חזרה למאמרים</a>
      <div class="article-body mt-8" set:html={article.bodyHtml} />
    </div>
  </section>

  <section class="border-t border-ink-line bg-ink-soft">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="font-heading text-xl font-bold text-text">מאמרים נוספים</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {otherArticles.map((a) => (
          <li><a href={`/articles/${a.slug}`} class="text-accent underline underline-offset-4">{a.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-ink-line bg-ink">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 px-4 py-16 text-center sm:px-6">
      <h2 class="font-heading text-2xl font-bold text-text">מעוניינים בשיחת ייעוץ?</h2>
      <Button href="/contact" variant="primary">קביעת שיחת ייעוץ ראשונית</Button>
    </div>
  </section>
</PageLayout>

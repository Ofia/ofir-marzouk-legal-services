---
import PageLayout from "../../layouts/PageLayout.astro";
import Button from "../../components/Button.astro";
import { en } from "../../content/home";
---

<PageLayout title="Page Not Found | Ofir Marzouk Law Office" description="The page you requested could not be found." content={en}>
  <section class="flex min-h-[70vh] items-center justify-center bg-ink">
    <div class="mx-auto max-w-lg px-4 text-center sm:px-6">
      <p class="font-heading text-6xl font-bold text-accent">404</p>
      <h1 class="mt-4 font-heading text-2xl font-bold text-text">Page Not Found</h1>
      <p class="mt-3 text-text-dim">The link may be broken, or the page may have been removed.</p>
      <Button href="/en" variant="primary" class="mt-8">Back to Home</Button>
    </div>
  </section>
</PageLayout>

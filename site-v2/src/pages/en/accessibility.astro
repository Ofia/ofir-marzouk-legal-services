---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { en } from "../../content/home";
import courthousePhoto from "../../assets/courthouse.jpg";
---

<PageLayout title="Accessibility Statement | Ofir Marzouk Law Office" description="Accessibility statement." content={en}>
  <PageHero photo={courthousePhoto} eyebrow="Legal" title="Accessibility Statement" flip />
  <!-- REVIEW: confirm accessibility level reached once a full audit (Phase 5) is complete -->
  <section class="bg-ink">
    <div class="article-body mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <p>This site aims to provide an accessible browsing experience for all users, including people with disabilities, in line with applicable Israeli accessibility regulations.</p>
      <h2>Accessibility inquiries</h2>
      <p>If you encounter an accessibility issue on this site, please contact us <a href="/en/contact" class="text-accent underline underline-offset-4">via the contact page</a>, and we will work to address it promptly.</p>
    </div>
  </section>
</PageLayout>

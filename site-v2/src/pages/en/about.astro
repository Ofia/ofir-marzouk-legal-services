---
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/Button.astro";
import { en } from "../../content/home";
import courthousePhoto from "../../assets/courthouse.jpg";
import headshot from "../../assets/headshot.jpg";
---

<PageLayout
  title="About Adv. Ofir Marzouk"
  description={en.about.blurb[0]}
  content={en}
>
  <PageHero photo={courthousePhoto} eyebrow="About" title="Adv. Ofir Marzouk" flip />

  <section class="bg-ink">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:flex-row lg:items-start">
      <Image src={headshot} alt="Adv. Ofir Marzouk" width={280} height={280} class="h-64 w-64 shrink-0 rounded-full object-cover grayscale" />
      <div class="text-center lg:text-start">
        {en.about.blurb.map((paragraph) => (
          <p class="mt-4 text-lg text-text-dim first:mt-0">{paragraph}</p>
        ))}
        <!-- REVIEW: credentials list — confirm education details -->
        <ul class="mt-6 flex flex-col gap-2 text-sm text-text-dim">
          <li>LLB, Licensed Attorney, Israel Bar Association</li>
          <li>Languages: Hebrew, English, Spanish, German</li>
        </ul>
        <Button href="/en/contact" variant="primary" class="mt-8">Book a Free Initial Consultation</Button>
      </div>
    </div>
  </section>
</PageLayout>

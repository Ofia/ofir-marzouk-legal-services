---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import UrgentSituations from "../../components/UrgentSituations.astro";
import PracticeGrid from "../../components/PracticeGrid.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import AboutTeaser from "../../components/AboutTeaser.astro";
import ArticlesTeaser from "../../components/ArticlesTeaser.astro";
import Faq from "../../components/Faq.astro";
import FinalCta from "../../components/FinalCta.astro";
import Footer from "../../components/Footer.astro";
import { en } from "../../content/home";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: en.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="Adv. Ofir Marzouk | International Criminal Defense, Extradition & Red Notices"
  description="Adv. Ofir Marzouk specializes in international criminal defense: extraditions, Interpol Red Notices, arrests abroad, and cybercrime. Free initial consultation."
  content={en}
  schema={[faqSchema]}
>
  <Header content={en} />
  <main class="flex-1">
    <Hero content={en} />
    <UrgentSituations content={en} />
    <PracticeGrid content={en} />
    <HowItWorks content={en} />
    <AboutTeaser content={en} />
    <ArticlesTeaser content={en} />
    <Faq content={en} />
    <FinalCta content={en} />
  </main>
  <Footer content={en} />
</BaseLayout>
